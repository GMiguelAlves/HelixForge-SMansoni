#!/usr/bin/env bash
# Copy to server.env, edit values, then: source config/server.env
export HF_PACKAGE_ROOT="/path/to/HelixForge-SMansoni"
export HF_HELIXFORGE_ROOT="/path/to/HelixForge"
export HF_HELIXFORGE_COMMIT="5d4b3e696319db5cd7633472504964f1dc7c0434"
export HF_DATA_ROOT="/scratch/$USER/smansoni_rnaseq/data"
export HF_REFERENCE_ROOT="/scratch/$USER/smansoni_rnaseq/reference"
export HF_RESULTS_ROOT="/scratch/$USER/smansoni_rnaseq/results"
export HF_WORK_ROOT="/scratch/$USER/smansoni_rnaseq/nextflow-work"
# Optional per-run result directory. Leave empty to use HF_RESULTS_ROOT/PROJECT.
export HF_PROJECT_RESULTS_ROOT=""
export HF_NEXTFLOW_BIN="${HF_HELIXFORGE_ROOT}/nextflow"
# Full site runtime PATH inherited by Nextflow. Put the certified Python
# environment that provides jsonschema first; keep site paths private.
export HF_CERTIFIED_RUNTIME_PATH="/path/to/certified-python/bin:/path/to/java/bin:/usr/bin:/bin"
export HF_PROFILES="apptainer,slurm"
export HF_SLURM_PARTITION=""
export HF_SLURM_ACCOUNT=""
export HF_SLURM_QOS=""
export HF_DOWNLOAD_CONCURRENCY=10
export HF_MAX_CONCURRENT_JOBS=5
